# Copy to .env. Only the dataset build needs DATA_DIR and SEC_USER_AGENT; serving gated models needs HF_TOKEN.
DATA_DIR=./data                       # SEC filings (fetch.py writes here)
SEC_USER_AGENT="your-name your-email" # SEC requires a contact in the User-Agent
HF_TOKEN=                             # gated models (Gemma, Llama) and hf_data.py push
EVAL_API_KEY=local                    # the key vLLM is started with (serve.py) and the runner sends
MLFLOW_TRACKING_URI=                  # optional: log each finished run to MLflow

# virtualenv with vllm==0.33.0 (run.sh), if not this repo's .venv
VLLM_VENV=
